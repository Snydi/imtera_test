COMPOSE_PROJECT_NAME=imtera_test
APP_NAME=Imtera
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:8080
APP_LOCALE=ru
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=imtera
DB_USERNAME=imtera
DB_PASSWORD=
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=660
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SEED_USER_NAME=imtera
SEED_USER_EMAIL=imtera@example.com
SEED_USER_PASSWORD=
YANDEX_MAPS_CONNECT_TIMEOUT=15
YANDEX_MAPS_TIMEOUT=60
YANDEX_MAPS_MAX_PAGES=100
YANDEX_MAPS_PAGE_DELAY_MS=350
YANDEX_MAPS_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/140.0.0.0 Safari/537.36"
